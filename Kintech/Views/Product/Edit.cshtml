@model Kintech.ViewModels.Product.EditProductViewModel
@{
    Layout = "_AdminLayout";
}

<div class="create-product-wrapper">
    <div class="create-card">
        <div class="create-header">
            <h2>Edit Product</h2>
            <p>Update product details</p>
        </div>

        <form method="post"
              asp-controller="Product"
              asp-action="Edit"
              enctype="multipart/form-data">

            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />             @* ✅ required for POST *@
            <input type="hidden" asp-for="ExistingImageUrl" /> @* ✅ keep existing image *@

            <div asp-validation-summary="ModelOnly" class="validation-box"></div>

            <div class="form-group">
                <label asp-for="Name"></label>
                <input asp-for="Name" class="premium-input" />
                <span asp-validation-for="Name" class="field-error"></span>
            </div>

            <div class="form-grid">
                <div class="form-group">
                    <label asp-for="Price"></label>
                    <input asp-for="Price" class="premium-input" />
                    <span asp-validation-for="Price" class="field-error"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Stock"></label>
                    <input asp-for="Stock" class="premium-input" />
                    <span asp-validation-for="Stock" class="field-error"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Description"></label>
                <textarea asp-for="Description" class="premium-input textarea"></textarea>
                <span asp-validation-for="Description" class="field-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="CategoryId">Category</label>
                <select asp-for="CategoryId"
                        asp-items="Model.Categories"
                        class="premium-input">
                    <option value="">-- Select Category --</option>
                </select>
                <span asp-validation-for="CategoryId" class="field-error"></span>
            </div>

            @* ✅ Show existing image with option to replace *@
            @if (!string.IsNullOrEmpty(Model.ExistingImageUrl))
            {
                <div class="form-group">
                    <label>Current Image</label>
                    <img src="@Model.ExistingImageUrl"
                         alt="Current product image"
                         style="max-height:120px; display:block; margin-bottom:8px;" />
                </div>
            }

            <div class="form-group">
                <label>Replace Image (optional)</label>
                <input type="file"
                       asp-for="ImageFile"
                       accept="image/*"
                       class="premium-file" />
                <span asp-validation-for="ImageFile" class="field-error"></span>
            </div>

            <button type="submit" class="btn-save">Save Changes</button>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}