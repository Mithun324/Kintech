@model Kintech.ViewModels.Home.HomeViewModel

@{
    ViewData["Title"] = "Home";

    var categories = ViewBag.Categories as List<Kintech.Models.Category>;
    var trendingProducts = ViewBag.TrendingProducts as List<Kintech.Models.Product>;
    var newArrivals = ViewBag.NewArrivals as List<Kintech.Models.Product>;

    var audioCatId = categories?.FirstOrDefault(c => c.Name.Contains("Audio"))?.Id ?? 1;
    var wearablesCatId = categories?.FirstOrDefault(c => c.Name.Contains("Wearable"))?.Id ?? 2;
    var gamingCatId = categories?.FirstOrDefault(c => c.Name.Contains("Gaming"))?.Id ?? 3;
    var computingCatId = categories?.FirstOrDefault(c => c.Name.Contains("Computing"))?.Id ?? 4;
    var powerCatId = categories?.FirstOrDefault(c => c.Name.Contains("Power"))?.Id ?? 5;
}

<!-- 1. ELECTRIC AURORA HERO SECTION WITH GIANT 3D PRODUCT STAGE -->
<div class="hero-aurora-wrapper">
    <div class="hero-aurora-orb orb-1"></div>
    <div class="hero-aurora-orb orb-2"></div>
    <div class="hero-aurora-orb orb-3"></div>

    <div class="hero-aurora-grid">
        <!-- Left Column: Hero Copy, Multi-Page CTAs & Live Proof Metrics -->
        <div class="hero-aurora-left">
            <div class="hero-eyebrow-pill">
                <span class="kt-pulse-dot"></span>
                <span>New Collection 2026 · Bangladesh</span>
            </div>

            <h1 class="hero-aurora-title">
                Upgrade Your<br />
                <span class="hero-gradient-text">Tech Lifestyle.</span>
            </h1>

            <p class="hero-aurora-sub">
                Discover flagship gaming laptops, ANC wireless audio, mechanical keyboards, and smart wearables — delivered to your doorstep in your chosen time slot.
            </p>

            <div class="hero-cta-group">
                <a asp-controller="Product" asp-action="Index" class="btn-aurora-primary">
                    <span>Shop All Gadgets</span>
                    <span class="btn-arrow">→</span>
                </a>
                <a href="#categoriesSection" class="btn-aurora-glass">
                    Explore Categories
                </a>
            </div>

            <div class="hero-metrics-bar">
                <div class="hero-metric-item">
                    <span class="hero-metric-val">4.9 ★</span>
                    <span class="hero-metric-lbl">2,400+ Verified Reviews</span>
                </div>
                <div class="hero-metric-item">
                    <span class="hero-metric-val">4 Slots</span>
                    <span class="hero-metric-lbl">Custom Delivery Windows</span>
                </div>
                <div class="hero-metric-item">
                    <span class="hero-metric-val">100%</span>
                    <span class="hero-metric-lbl">Official Brand Warranty</span>
                </div>
            </div>
        </div>

        <!-- Right Column: Interactive 3D Product Showcase Stage -->
        @if (Model != null && Model.Products != null && Model.Products.Any())
        {
            var slideIndex = 0;
            <div class="hero-3d-stage-col">
                <div class="hero-3d-stage" id="hero3DStage">
                    <div class="hero-3d-tilt-card" id="hero3DTiltCard">

                        <!-- Floating 3D Depth Badges -->
                        <div class="hero-float-badge badge-top-left">
                            <span class="badge-dot"></span>
                            <span>Flagship 3D Showcase</span>
                        </div>
                        <div class="hero-float-badge badge-top-right">
                            <span>★ Top Rated Gear</span>
                        </div>

                        <!-- 5-Product 3D Slides -->
                        <div class="hero-3d-slides-viewport">
                            @foreach (var product in Model.Products.Take(5))
                            {
                                <div class="hero-slide @(slideIndex == 0 ? "active" : "")">
                                    <div class="hero-3d-product-frame">
                                        <!-- Ambient 3D Backlight Behind Product -->
                                        <div class="hero-3d-backlight"></div>

                                        <!-- Clickable Giant 3D Product Image -->
                                        <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id" class="hero-3d-img-link">
                                            <img src="@product.ImageUrl"
                                                 alt="@product.Name"
                                                 class="hero-3d-product-img"
                                                 onerror="this.src='/images/HomePage/HomeProductImg.png'" />
                                        </a>

                                        <!-- 3D Floor Reflection Pedestal -->
                                        <div class="hero-3d-pedestal"></div>
                                    </div>

                                    <!-- Product Info & Direct Multi-Page Actions -->
                                    <div class="hero-3d-info-bar">
                                        <div class="hero-3d-meta">
                                            <span class="hero-3d-cat-tag">
                                                @(product.Category != null ? product.Category.Name : "Featured Gadget")
                                            </span>
                                            <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id" class="hero-3d-product-title">
                                                @product.Name
                                            </a>
                                            <div class="hero-3d-price-row">
                                                <span class="hero-3d-price">৳@product.Price.ToString("N2")</span>
                                                <span class="hero-3d-warranty">· Official Warranty</span>
                                            </div>
                                        </div>

                                        <div class="hero-3d-actions">
                                            <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id" class="btn-hero-details">
                                                Details
                                            </a>
                                            <a asp-controller="Cart" asp-action="Add" asp-route-id="@product.Id" class="btn-hero-cart">
                                                + Add to Cart
                                            </a>
                                        </div>
                                    </div>
                                </div>
                                slideIndex++;
                            }
                        </div>

                        <!-- Slider Dots & Prev/Next Controls -->
                        <div class="hero-3d-controls">
                            <div class="hero-dots">
                                @for (int i = 0; i < Math.Min(Model.Products.Count, 5); i++)
                                {
                                    <span class="hero-dot @(i == 0 ? "active" : "")" onclick="goToSlide(@i)"></span>
                                }
                            </div>
                            <div class="hero-nav-arrows">
                                <button type="button" class="hero-arrow-btn" onclick="prevSlide()" aria-label="Previous Slide">←</button>
                                <button type="button" class="hero-arrow-btn" onclick="nextSlide()" aria-label="Next Slide">→</button>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- 2. VIBRANT BENTO CATEGORY SHOWCASE -->
<div class="home-section" id="categoriesSection">
    <div class="section-header-row">
        <div>
            <span class="section-eyebrow">Curated Departments</span>
            <h2 class="section-heading">Shop by Category</h2>
        </div>
        <a asp-controller="Product" asp-action="Index" class="section-link-more">
            View All Categories →
        </a>
    </div>

    <div class="bento-grid-aurora">
        <!-- Large Left Tile: Gaming Gear -->
        <a asp-controller="Product" asp-action="Index" asp-route-categoryId="@gamingCatId" class="bento-card bento-large bento-gaming">
            <div class="bento-content">
                <span class="bento-pill">Pro Esports Setup</span>
                <h3 class="bento-title-lg">Gaming Gear &amp; Laptops</h3>
                <p class="bento-desc">High-refresh gaming laptops, RGB mechanical keyboards &amp; surround headsets.</p>
                <span class="bento-cta-btn">Explore Gaming →</span>
            </div>
            <img src="/images/HomePage/HomeProductImg.png"
                 alt="Gaming Gear"
                 class="bento-img-3d bento-img-large" />
        </a>

        <!-- Right 2x2 Grid -->
        <div class="bento-subgrid">
            <!-- Audio -->
            <a asp-controller="Product" asp-action="Index" asp-route-categoryId="@audioCatId" class="bento-card bento-small bento-audio">
                <div class="bento-content">
                    <span class="bento-tag">Hi-Res &amp; ANC</span>
                    <h3 class="bento-title-sm">Audio &amp; Earbuds</h3>
                    <p class="bento-sub">Wireless Buds &amp; Speakers</p>
                </div>
                <span class="bento-link-inline">Shop Audio →</span>
                <img src="/images/HomePage/HomeProductImg-1.png"
                     alt="Audio"
                     class="bento-img-3d bento-img-sm" />
            </a>

            <!-- Smart Wearables -->
            <a asp-controller="Product" asp-action="Index" asp-route-categoryId="@wearablesCatId" class="bento-card bento-small bento-wearables">
                <div class="bento-content">
                    <span class="bento-tag">Fitness &amp; Health</span>
                    <h3 class="bento-title-sm">Smartwatches</h3>
                    <p class="bento-sub">Amazfit &amp; Fitness Bands</p>
                </div>
                <span class="bento-link-inline">Shop Watches →</span>
                <img src="/images/amzefitwatch1.jpg"
                     alt="Smartwatches"
                     class="bento-img-3d bento-img-sm" />
            </a>

            <!-- Computing -->
            <a asp-controller="Product" asp-action="Index" asp-route-categoryId="@computingCatId" class="bento-card bento-small bento-computing">
                <div class="bento-content">
                    <span class="bento-tag">Workstation</span>
                    <h3 class="bento-title-sm">Keyboards &amp; Mice</h3>
                    <p class="bento-sub">Wireless Combos &amp; Hubs</p>
                </div>
                <span class="bento-link-inline">Shop Peripherals →</span>
                <img src="/images/HomePage/HomeProductImg-2.png"
                     alt="Computing"
                     class="bento-img-3d bento-img-sm" />
            </a>

            <!-- Power & Charging -->
            <a asp-controller="Product" asp-action="Index" asp-route-categoryId="@powerCatId" class="bento-card bento-small bento-power">
                <div class="bento-content">
                    <span class="bento-tag">GaN &amp; 50W Max</span>
                    <h3 class="bento-title-sm">Power &amp; Charging</h3>
                    <p class="bento-sub">Power Banks &amp; Adapters</p>
                </div>
                <span class="bento-link-inline">Shop Power →</span>
                <img src="/images/HomePage/HomeProductImg-3.png"
                     alt="Power & Charging"
                     class="bento-img-3d bento-img-sm" />
            </a>
        </div>
    </div>
</div>

<!-- 3. TRENDING PRODUCTS SECTION -->
<div class="home-section">
    <div class="section-header-row">
        <div>
            <span class="section-eyebrow">Top Picks For You</span>
            <h2 class="section-heading">🔥 Trending Products</h2>
        </div>
        <div class="category-quick-pills">
            <a asp-controller="Product" asp-action="Index" class="cat-pill active">All Gadgets</a>
            <a asp-controller="Product" asp-action="Index" asp-route-categoryId="@gamingCatId" class="cat-pill">Gaming</a>
            <a asp-controller="Product" asp-action="Index" asp-route-categoryId="@audioCatId" class="cat-pill">Audio</a>
            <a asp-controller="Product" asp-action="Index" asp-route-categoryId="@wearablesCatId" class="cat-pill">Wearables</a>
            <a asp-controller="Product" asp-action="Index" asp-route-categoryId="@computingCatId" class="cat-pill">Computing</a>
            <a asp-controller="Product" asp-action="Index" asp-route-categoryId="@powerCatId" class="cat-pill">Power</a>
        </div>
    </div>

    @if (trendingProducts != null && trendingProducts.Any())
    {
        <div class="product-grid">
            @foreach (var item in trendingProducts)
            {
                <div class="product-card product-card-v2">
                    <div class="product-img-wrap">
                        <span class="product-badge-pill">Trending</span>
                        @if (item.Stock <= 5 && item.Stock > 0)
                        {
                            <span class="product-stock-pill low">Only @item.Stock left</span>
                        }
                        else if (item.Stock > 5)
                        {
                            <span class="product-stock-pill ok">In Stock</span>
                        }
                        <a asp-controller="Product" asp-action="Details" asp-route-id="@item.Id" class="product-img-link">
                            <img src="@item.ImageUrl"
                                 class="product-img"
                                 alt="@item.Name"
                                 onerror="this.src='/images/HomePage/HomeProductImg.png'" />
                        </a>
                    </div>
                    <div class="product-body">
                        <div class="product-cat-label">
                            @(item.Category != null ? item.Category.Name : "Tech Accessory")
                        </div>
                        <a asp-controller="Product" asp-action="Details" asp-route-id="@item.Id" style="text-decoration:none;">
                            <div class="product-title">@item.Name</div>
                        </a>
                        <div class="product-price-footer">
                            <div>
                                <span class="price-caption">Price</span>
                                <div class="product-price">৳@item.Price.ToString("N2")</div>
                            </div>
                            <div class="product-card-btns">
                                <a asp-controller="Product" asp-action="Details" asp-route-id="@item.Id" class="btn-card-outline">
                                    View
                                </a>
                                <a asp-controller="Cart" asp-action="Add" asp-route-id="@item.Id" class="btn-main btn-card-add">
                                    + Cart
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <p class="text-muted">No trending products found.</p>
    }
</div>

<!-- 4. FLASH DEAL PROMO BANNER -->
<div class="promo-aurora-banner">
    <div class="promo-aurora-glow"></div>
    <div class="promo-aurora-content">
        <span class="promo-flash-tag">⚡ Flash Deal of the Week</span>
        <h2>Save Up To <span class="promo-highlight">40% Off</span> Selected Pro Audio &amp; Gaming Gear</h2>
        <p>Grab limited-stock bundles with express Dhaka dispatch and flexible 4-slot delivery scheduling at checkout.</p>
        <div class="promo-cta-row">
            <a asp-controller="Product" asp-action="Index" class="btn-promo-gold">
                Shop Flash Deals →
            </a>
            <a asp-controller="Product" asp-action="Index" asp-route-categoryId="@gamingCatId" class="btn-promo-outline">
                Browse Gaming Gear
            </a>
        </div>
    </div>
    <div class="promo-aurora-spotlight">
        <div class="promo-spotlight-card">
            <span class="promo-discount-badge">-35% OFF</span>
            <img src="/images/HomePage/HomeProductImg-1.png"
                 alt="Gaming Headset"
                 class="promo-spotlight-img" />
            <div class="promo-spotlight-title">Pro RGB Gaming &amp; ANC Audio</div>
            <div class="promo-spotlight-sub">Official Brand Warranty · Express Delivery</div>
        </div>
    </div>
</div>

<!-- 5. NEW ARRIVALS SECTION -->
<div class="home-section">
    <div class="section-header-row">
        <div>
            <span class="section-eyebrow">Fresh In Stock</span>
            <h2 class="section-heading">✨ New Arrivals</h2>
        </div>
        <a asp-controller="Product" asp-action="Index" class="section-link-more">
            See All Products →
        </a>
    </div>

    @if (newArrivals != null && newArrivals.Any())
    {
        <div class="product-grid">
            @foreach (var item in newArrivals)
            {
                <div class="product-card product-card-v2">
                    <div class="product-img-wrap">
                        <span class="product-badge-pill badge-new">New</span>
                        <a asp-controller="Product" asp-action="Details" asp-route-id="@item.Id" class="product-img-link">
                            <img src="@item.ImageUrl"
                                 class="product-img"
                                 alt="@item.Name"
                                 onerror="this.src='/images/HomePage/HomeProductImg.png'" />
                        </a>
                    </div>
                    <div class="product-body">
                        <div class="product-cat-label">
                            @(item.Category != null ? item.Category.Name : "New Arrival")
                        </div>
                        <a asp-controller="Product" asp-action="Details" asp-route-id="@item.Id" style="text-decoration:none;">
                            <div class="product-title">@item.Name</div>
                        </a>
                        <div class="product-price-footer">
                            <div>
                                <span class="price-caption">Price</span>
                                <div class="product-price">৳@item.Price.ToString("N2")</div>
                            </div>
                            <div class="product-card-btns">
                                <a asp-controller="Product" asp-action="Details" asp-route-id="@item.Id" class="btn-card-outline">
                                    View
                                </a>
                                <a asp-controller="Cart" asp-action="Add" asp-route-id="@item.Id" class="btn-main btn-card-add">
                                    + Cart
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <p class="text-muted">No new arrivals available.</p>
    }
</div>

<!-- 6. WHY SHOP WITH KINTECH -->
<div class="home-section">
    <div class="text-center mb-4">
        <span class="section-eyebrow">The Kintech Promise</span>
        <h2 class="section-heading">Why Shop With Kintech?</h2>
    </div>
    <div class="why-grid">
        <div class="why-card">
            <div class="why-icon">🚚</div>
            <div class="why-title">Fast Dispatch</div>
            <div class="why-desc">Same-day dispatch on orders placed before 2 PM across Dhaka.</div>
        </div>
        <div class="why-card">
            <div class="why-icon">✅</div>
            <div class="why-title">100% Genuine</div>
            <div class="why-desc">Every product is sourced directly from authorized brand distributors.</div>
        </div>
        <div class="why-card">
            <div class="why-icon">📦</div>
            <div class="why-title">Scheduled Delivery</div>
            <div class="why-desc">Pick your convenient 3-hour delivery time slot at checkout.</div>
        </div>
        <div class="why-card">
            <div class="why-icon">↩️</div>
            <div class="why-title">7-Day Easy Return</div>
            <div class="why-desc">Not satisfied? Return within 7 days for a full replacement.</div>
        </div>
        <div class="why-card">
            <div class="why-icon">🔒</div>
            <div class="why-title">Secure Checkout</div>
            <div class="why-desc">Supports bKash, Nagad, VISA, Mastercard &amp; Cash on Delivery.</div>
        </div>
    </div>
</div>

<!-- 7. FREE DELIVERY & STATS BANNER -->
<div class="perks-banner">
    <div class="perks-left">
        <span class="perks-pill">Limited Time</span>
        <h3>Free Delivery on Orders Over ৳2,000</h3>
        <p>Shop our full range of phone accessories, audio gear, and smart wearables — delivered right to your door.</p>
        <a asp-controller="Product" asp-action="Index" class="btn-perks">Browse All Products →</a>
    </div>
    <div class="perks-right">
        <div class="perks-stat">
            <div class="perks-num">5,000+</div>
            <div class="perks-label">Happy Customers</div>
        </div>
        <div class="perks-stat">
            <div class="perks-num">500+</div>
            <div class="perks-label">Products</div>
        </div>
        <div class="perks-stat">
            <div class="perks-num">24h</div>
            <div class="perks-label">Express Delivery</div>
        </div>
    </div>
</div>