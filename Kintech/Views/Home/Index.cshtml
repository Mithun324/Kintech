    <div class="kt-products-grid">
        @foreach (var item in trendingProducts)
        {
            var imgSrc = ResolveImg(item.ImageUrl, "/images/HomePage/HomeProductImg.png");
            var oldPrice = item.Price * 1.15m;
            var isLow = item.Stock > 0 && item.Stock <= 5;
            var stockPct = Math.Clamp(item.Stock * 6, 18, 100);
            var reviews = 48 + ((item.Id * 17) % 90);

            <div class="kt-RichCard">
                <div class="kt-RichCard-imgbox">
                    <span class="kt-badge-top-left">🔥 Trending</span>
                    <span class="kt-badge-top-right @(isLow ? "low" : "")">
                        @(isLow ? $"Only {item.Stock} left" : "In Stock")
                    </span>
                    <a asp-controller="Product" asp-action="Details" asp-route-id="@item.Id">
                        <img src="@imgSrc"
                             alt="@item.Name"
                             class="kt-RichCard-img"
                             onerror="this.onerror=null;this.src='/images/HomePage/HomeProductImg.png';" />
                    </a>
                </div>

                <div class="kt-RichCard-body">
                    <div class="kt-RichCard-meta">
                        <span class="kt-RichCard-cat">@(item.Category != null ? item.Category.Name : "Flagship Tech")</span>
                        <span class="kt-RichCard-stars">★★★★★ (4.9 · @reviews)</span>
                    </div>

                    <a asp-controller="Product" asp-action="Details" asp-route-id="@item.Id" class="kt-RichCard-title">
                        @item.Name
                    </a>

                    <p class="kt-RichCard-desc">
                        @(!string.IsNullOrWhiteSpace(item.Description)
                            ? item.Description
                            : "Official brand warranty, low-latency performance, and premium build quality engineered for power users.")
                    </p>

                    <div class="kt-RichCard-specs">
                        <span class="kt-spec-pill">🛡 1 Yr Warranty</span>
                        <span class="kt-spec-pill green">🚚 Express Dispatch</span>
                        <span class="kt-spec-pill">⚡ 100% Genuine</span>
                    </div>

                    <div class="kt-stock-progress">
                        <div class="kt-stock-labels">
                            <span>Availability</span>
                            <span>@(item.Stock > 0 ? $"{item.Stock} units ready" : "In Stock")</span>
                        </div>
                        <div class="kt-stock-bar">
                            <div class="kt-stock-bar-fill" style="width: @(stockPct)%;"></div>
                        </div>
                    </div>

                    <div class="kt-RichCard-footer">
                        <div>
                            <span style="font-size:0.7rem; color:#64748b; display:block;">Special Price</span>
                            <span class="kt-price-main">৳@item.Price.ToString("N0")</span>
                            <span class="kt-price-old">৳@oldPrice.ToString("N0")</span>
                        </div>
                        <div class="kt-card-actions">
                            <a asp-controller="Product" asp-action="Details" asp-route-id="@item.Id" class="kt-btn-spec">Specs</a>
                            <a asp-controller="Cart" asp-action="Add" asp-route-id="@item.Id" class="kt-btn-cart">+ Cart</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

