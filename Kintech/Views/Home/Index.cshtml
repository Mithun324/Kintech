<script>
    (function () {
        let currentHeroIdx = 0;
        const slides = document.querySelectorAll('#heroSlidesViewport .kt-hero-slide');
        const dots = document.querySelectorAll('#heroDotsContainer .kt-dot');

        window.showHeroSlide = function (index) {
            if (!slides.length) return;
            currentHeroIdx = (index + slides.length) % slides.length;
            slides.forEach((s, i) => s.classList.toggle('active', i === currentHeroIdx));
            dots.forEach((d, i) => d.classList.toggle('active', i === currentHeroIdx));
        };

        window.nextHeroSlide = function () {
            window.showHeroSlide(currentHeroIdx + 1);
        };

        window.prevHeroSlide = function () {
            window.showHeroSlide(currentHeroIdx - 1);
        };

        window.goToHeroSlide = function (index) {
            window.showHeroSlide(index);
        };

        setInterval(() => window.nextHeroSlide(), 4500);
    })();
</script>